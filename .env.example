PORT=3000
NETWORK=testnet
REDIS_URL=redis://localhost:6379

# API key tiers (comma-separated hashed keys)
# Keys are SHA-256 hashed before storage in Redis
# Set via: redis-cli SADD humonics:keys:free <sha256(key)>
#          redis-cli SADD humonics:keys:paid <sha256(key)>

# Soroban contract addresses
CERTIFICATE_REGISTRY_TESTNET=
VERIFICATION_GATEWAY_TESTNET=
HUM_TOKEN_TESTNET=
CERTIFICATE_REGISTRY_MAINNET=
VERIFICATION_GATEWAY_MAINNET=
HUM_TOKEN_MAINNET=

LOG_LEVEL=info
